datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  UPI_SIMULATED
  CARD_SIMULATED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  addresses    Address[]

  @@map("users")
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  street        String
  landmark      String?
  city          String
  postalCode    String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("addresses")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       MenuItem[]

  @@map("categories")
}

model MenuItem {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  description     String
  price           Decimal         @db.Decimal(10, 2)
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  isVeg           Boolean         @default(true)
  isAvailable     Boolean         @default(true)
  isFeatured      Boolean         @default(false)
  imageUrl        String
  prepTimeMinutes Int             @default(25)
  spiceLevel      Int             @default(1)
  calories        Int?
  allergens       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  addons          MenuItemAddon[]
  orderItems      OrderItem[]

  @@map("menu_items")
}

model MenuItemAddon {
  id          String   @id @default(uuid())
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal  @db.Decimal(10, 2)
  isRequired  Boolean  @default(false)
  maxSelection Int     @default(1)

  @@map("menu_item_addons")
}

model Order {
  id                    String               @id @default(uuid())
  orderNumber           String               @unique
  userId                String?
  user                  User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName          String
  customerEmail         String
  customerPhone         String
  orderType             OrderType            @default(DELIVERY)
  deliveryAddress       String?
  orderNotes            String?
  subtotal              Decimal              @db.Decimal(10, 2)
  taxAmount             Decimal              @db.Decimal(10, 2)
  deliveryFee           Decimal              @db.Decimal(10, 2)
  discountAmount        Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount           Decimal              @db.Decimal(10, 2)
  couponCode            String?
  paymentMethod         PaymentMethod        @default(CASH_ON_DELIVERY)
  paymentStatus         PaymentStatus        @default(PENDING)
  currentStatus         OrderStatus          @default(PLACED)
  cancellationReason    String?
  estimatedDeliveryTime DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]

  @@map("orders")
}

model OrderItem {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName       String
  itemPrice      Decimal   @db.Decimal(10, 2)
  quantity       Int
  subtotal       Decimal   @db.Decimal(10, 2)
  selectedAddons String?   // JSON encoded array of { name, price }

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  notes     String?
  changedBy String      @default("SYSTEM")
  timestamp DateTime    @default(now())

  @@map("order_status_history")
}

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  description       String
  discountType      DiscountType
  discountValue     Decimal      @db.Decimal(10, 2)
  minOrderAmount    Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())

  @@map("coupons")
}
